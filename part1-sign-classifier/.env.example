# Part 1 — Sentence Composer (LLM API) — part1-sign-classifier/.env.example
#
# Copy thành `.env` rồi điền key. File `.env` nằm trong .gitignore — KHÔNG commit key.
# Không điền key vẫn chạy được (ghép câu cơ bản, không qua LLM).

# Bật gọi LLM (0 = tắt, luôn dùng ghép cơ bản). Mặc định: 1
# VSL_LLM_ENABLED=1

# Endpoint tương thích OpenAI (OpenAI / Groq / DeepSeek / OpenRouter / Gemini-compat)
# VSL_LLM_BASE_URL=https://api.openai.com/v1/chat/completions

# API key của bạn — ĐIỀN VÀO ĐÂY (bỏ comment dòng dưới)
# VSL_LLM_API_KEY=sk-...

# Tên model (khớp với provider ở BASE_URL)
# VSL_LLM_MODEL=gpt-4o-mini
